name:                Halemans
version:             2.4.0
synopsis:            Alert aggregation and enrichment dashboard for Zabbix, Grafana, Alertmanager and generic webhooks
description:         Halemans collects alerts from Zabbix, Grafana, Alertmanager and
                     generic webhooks into a single dashboard, enriches them with CMDB
                     (Confluence, Jira Assets), Jira and LLM context, and provides
                     facets, custom dashboards, reports and a read-only JSON API.
license:             MIT
license-file:        LICENSE
author:              Sergey Bubnov
maintainer:          omgbebebe@gmail.com
copyright:           (c) 2026 Sergey Bubnov
-- category:
build-type:          Simple
cabal-version:       >=1.10

executable Halemans
  main-is:             Main.hs
  -- other-modules:
  -- other-extensions:
  build-depends:
  	ihp,
  	base,
  	wai,
    text,
    hspec,
    ihp-hspec
  hs-source-dirs:      .
  default-language:    Haskell2010
  extensions:
    OverloadedStrings
    , NoImplicitPrelude
    , ImplicitParams
    , Rank2Types
    , DisambiguateRecordFields
    , NamedFieldPuns
    , DuplicateRecordFields
    , OverloadedLabels
    , FlexibleContexts
    , TypeSynonymInstances
    , FlexibleInstances
    , QuasiQuotes
    , TypeFamilies
    , PackageImports
    , ScopedTypeVariables
    , RecordWildCards
    , TypeApplications
    , DataKinds
    , InstanceSigs
    , DeriveGeneric
    , MultiParamTypeClasses
    , TypeOperators
    , DeriveDataTypeable
    , MultiWayIf
    , UndecidableInstances
    , BlockArguments
    , PartialTypeSignatures
    , LambdaCase
    , DefaultSignatures
    , EmptyDataDeriving
    , BangPatterns
    , BlockArguments
    , MultiWayIf
    , FunctionalDependencies
    , PartialTypeSignatures
    , StandaloneDeriving
    , DerivingVia