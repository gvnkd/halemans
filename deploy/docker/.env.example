# Halemans docker deployment configuration.
# Copy to .env and fill in the required values: cp .env.example .env
# Every variable is passed through to the app/worker containers, so optional
# sections can stay commented out when unused.

# ---------------------------------------------------------------- required ---

# Name of the contained postgres user (default halemans). Only takes effect
# on a FRESH db-data volume — the postgres image consumes POSTGRES_USER once,
# at first cluster init. Renaming later requires dump/restore into a new
# volume.
#POSTGRES_USER=halemans

# Password for the contained postgres user. It is interpolated into
# DATABASE_URL — keep it URL-safe (alphanumeric recommended).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Session signing secret. Without it sessions invalidate on every restart.
# Generate: openssl rand -hex 32
IHP_SESSION_SECRET=

# Webhook token of the provisioned "generic-webhook" source (referenced from
# provision.json via tokenEnv; boot aborts if unset).
# Generate: openssl rand -hex 24
# Fire alerts with:
#   curl -X POST "http://<host>:${HALEMANS_PORT}/hooks/generic/<this token>" \
#        -H 'Content-Type: application/json' \
#        -d '{"status":"firing","alerts":[{"status":"firing","fingerprint":"x1","labels":{"severity":"critical","env":"prod"},"annotations":{"summary":"test"}}]}'
HALEMANS_GENERIC_HOOK_TOKEN=

# ---------------------------------------------------------------- optional ---

# Image to deploy. Built and pushed by .github/workflows/docker-images.yaml;
# pin to a tag (":v1.2.3" or ":<commit-sha>") for controlled upgrades.
#HALEMANS_IMAGE=ghcr.io/gvnkd/halemans:latest

# Host port the web UI/API is published on (container port stays 8000).
#HALEMANS_PORT=8000

# App log verbosity: debug|info|warn|error (default info). Invalid values
# abort startup. Framework request logging is separate: set to 0 to disable.
#HALEMANS_LOG_LEVEL=info
#HALEMANS_ACCESS_LOG=1

# Postgres image.
#POSTGRES_IMAGE=postgres:16-alpine

# External base URL, used in links the app generates (webhooks, e-mails).
# Default: http://localhost:8000
#IHP_BASEURL=https://halemans.example.com

# --- external alert sources ----------------------------------------------------
# provision.example.json ships zabbix/grafana/alertmanager entries
# (enabled: false) that reference these variables via tokenEnv — provisioning
# validates every referenced variable at boot, so either set them or delete
# the corresponding entry from provision.json.
#ZABBIX_TOKEN=
#GRAFANA_TOKEN=
# Webhook token the external alertmanager points at
# (receiver url: http://<host>/hooks/alertmanager/<this token>).
#HALEMANS_AM_HOOK_TOKEN=

# --- context integrations (milestones 3 + 10) -------------------------------
# Jira and CMDB (Confluence) are not alert sources: connections are managed
# in the admin UI (Admin → Integrations) or provisioned via the
# "jiraConfigs"/"cmdbConfigs" sections (see provision.example.json), each
# with MULTIPLE search projects/spaces. Only the TOKENS live in env vars —
# the variables named by each connection's "tokenEnv". Per-source
# "jiraProjects"/"cmdbSpaces" config arrays override the connection's search
# scope for that source (first jiraProjects entry = ticket-creation target);
# "writeBack"/"jiraWritable" gate ack/close mirroring + ticket creation.
#JIRA_TOKEN=
#CONFLUENCE_TOKEN=

# --- LLM enrichment (milestone 4) ----------------------------------------------
# Without an enabled llm_configs row (provision "llm" section) the app falls
# back to these env vars. Both ENDPOINT and MODEL must be set to enable.
#LLM_ENDPOINT=http://host.docker.internal:11434
#LLM_MODEL=qwen2.5
#LLM_API_KEY=
#LLM_PROVIDER_NAME=default
#LLM_TOOLS=0

# --- Agent + internal API (internal API milestone) ---------------------------
# The embedded agent (floating chat widget in the web UI) needs an enabled LLM
# provider (provision "llm" section above) and works out of the box for
# logged-in users — no env vars required.
#
# The standalone MCP stdio server (/bin/HalemansMcp, for a locally spawned
# LLM agent speaking MCP) acts as a dedicated service account. On first boot
# it auto-creates user "mcp@localhost" (no usable password) bound to a
# dedicated "mcp" role whose only privilege is "view". Widening the role is
# an administrator decision — either in the roles UI (persisted) or via env:
#
# HALEMANS_MCP_USER — act as another existing user instead of mcp@localhost.
#HALEMANS_MCP_USER=admin@example.com
#
# HALEMANS_MCP_PRIVILEGES — comma-separated privileges the "mcp" role gets
# (view, ack, close, escalate, manage_blackouts, manage_rules, manage_users,
# manage_sources, admin). When set, the env is the source of truth and is
# re-synced onto the role on every boot; when unset the role keeps whatever
# the administrator configured in the UI.
#HALEMANS_MCP_PRIVILEGES=view
#
# HALEMANS_INTERNAL_TOKEN — enables the unstable /api/internal/* JSON surface
# (local agent + tests; endpoints graduate to /api/v1 as they stabilize).
# Every call needs the marker header X-Halemans-Internal: 1, this bearer
# token, and an X-Act-As: <email> header; granted calls are audit-logged.
# Leave unset to keep the surface disabled (default).
# Generate: openssl rand -hex 24
#HALEMANS_INTERNAL_TOKEN=
